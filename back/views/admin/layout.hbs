<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patitas</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
        integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        .titulo {
            color: #61001D;
        }

        .logo {
            width: 50px;
            height: 50px;
            background: #61001D;
            border: #61001D solid 0.5px;
        }

        .logo i {
            color: #f0e7c7;
            font-size: 1.5rem;
        }

        .navbar {
            color: #61001D;
            background-color: #f0e7c7;
            border: #61001D solid 0.5px;
            border-radius: 50px;
            font-size: 1.2rem;
            width: 90%;
            height: 80px;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            padding: 20px;
            position: fixed;
            z-index: 1000;
        }

        .footer {
            background-color: #61001D;
            color: white;
            padding: 50px 0 20px;
        }

        .logo-footer {
            width: 40px;
            height: 40px;
            border: #f7e5a6 solid 0.5px;
            margin-top: 30px;
        }

        .logo-footer i {
            font-size: 1.5rem;
        }

        .titulo-footer {
            font-size: 2.0rem;
            font-weight: bold;
            margin-top: 30px;
        }

        .footer h4 {
            color: #f7e5a6;
            margin-bottom: 0px;
        }

        .footer p {
            margin-bottom: 10px;
        }

        .footer a {
            color: white;
            text-decoration: none;
            transition: color .3s ease;
        }

        .footer a:hover {
            color: #f7e5a6;
        }

        .footer hr {
            border-color: rgba(255, 255, 255, .2);
        }

        .btn-patitas {
            background-color: #f0e7c7;
            border: #61001D solid 0.5px;
            color: #61001D;
        }

        .btn-patitas:hover {
            background-color: #61001D;
            border-color: #61001D;
            color: #f0e7c7;
        }

        .btn-cancelar {
            background-color: transparent;
            border: #61001D solid 0.5px;
            color: #61001D;
        }

        .btn-cancelar:hover {
            background-color: #61001D;
            color: #f0e7c7;
        }

        .btn-logout {
            background-color: transparent;
            border: #61001D solid 0.5px;
            color: #61001D;
            border-radius: 50px;
            padding: 4px 14px;
            font-size: 0.85rem;
            line-height: 1.4;
        }

        .btn-logout:hover {
            background-color: #61001D;
            color: #f0e7c7;
        }

        .productos-grupo div h2 {
            font-family: "Google Sans Flex", sans-serif;
            color: #61001D;
        }

        .producto-card {
            height: 100%;
            border: 1px solid #61001D;
            border-radius: 20px;
            overflow: hidden;
        }


        .producto-card h5 {
            color: #61001D;
            font-family: "Google Sans Flex", sans-serif;
            font-weight: bold;
        }

        .producto-card p {
            font-family: "Google Sans Flex", sans-serif;
            color: #61001D;
        }

        .producto-card div {
            background-color: #f0e7c7;
        }

        .productos-grupo {
            margin-bottom: 100px;
        }

        .producto-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-sm">
        <div class="container-fluid">
            <!-- Logo -->
            <div class="navbar-brand d-flex align-items-center">
                <div class="logo rounded-circle d-flex justify-content-center align-items-center me-2">
                    <i class="fa-solid fa-paw"></i>
                </div>
                <h1 class="titulo fs-3 mb-0">Patitas</h1>
            </div>
        </div>

        {{#if logueado}}
        <a href="/admin/login/logout" class="btn btn-logout ms-auto">
            Cerrar sesión
        </a>
        {{/if}}
    </nav>

    <main class="flex-grow-1 d-flex align-items-center justify-content-center"
        style="padding-top: 120px; padding-bottom: 40px;">
        {{{body}}}
    </main>


    <footer class="footer">
        <div class="container">

            <div class="row text-center text-md-start">
                <div class="d-flex justify-content-center align-items-center mb-2">
                    <div class="logo logo-footer rounded-circle d-flex justify-content-center align-items-center me-2">
                        <i class="fa-solid fa-paw"></i>
                    </div>
                    <h4 class="titulo-footer mb-0">Patitas - Lucas Melnicov</h4>
                </div>
            </div>

            <hr>

            <p class="text-center">
                © 2026 Patitas. Todos los derechos reservados.
            </p>
        </div>
    </footer>
</body>

</html>