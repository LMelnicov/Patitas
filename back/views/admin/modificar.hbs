<div class="container" style="margin:100px 0">
    <div class="row">
        <div class="col-6 offset-3">
            <h4 class="mb-3">Modificar el producto</h4>
            <form action="/admin/productos/modificar" method="post" enctype="multipart/form-data">

                <input type="hidden" value="{{producto.id}}" name="id">

                <div class="mb-3">
                    <label for="categoria" class="form-label">Categoría</label>
                    <select id="categoria" name="categoria" class="form-select" required>
                        <option value="al" {{#if Alimentacion}}selected{{/if}}>Alimentacion</option>
                        <option value="con" {{#if Confort}}selected{{/if}}>Confort</option>
                        <option value="acc" {{#if Accesorios}}selected{{/if}}>Accesorios</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="titulo" class="form-label">Título</label>
                    <input type="text" id="titulo" class="form-control" name="titulo" value="{{producto.titulo}}">
                </div>

                <div class="mb-3">
                    <label for="descripcion" class="form-label">Descripción</label>
                    <textarea id="descripcion" name="descripcion" class="form-control"
                        rows="4">{{producto.descripcion}}</textarea>
                </div>

                <div class="mb-3">
                    <p>
                        <label>Imagen: <input type="file" name="imagen" id="imagen"></label>
                    </p>
                    <p>
                        <label><input type="checkbox" name="img_delete" id="img_delete" value="1">
                            Eliminar imagen actual?</label>
                        <input type="hidden" name="img_original" value="{{producto.img_id}}">
                    </p>
                </div>

                <button type="submit" class="btn btn-patitas">Modificar</button>
                <a href="/admin/productos" class="btn btn-cancelar ms-2">Cancelar</a>
            </form>
            {{#if error}}
            <p class="text-danger mt-3">{{message}}</p>
            {{/if}}
        </div>
    </div>
</div>