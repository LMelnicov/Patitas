<div class="container" style="margin-top: 50px;">

    <div class="mb-4">
        <a class="btn btn-success" href="/admin/productos/agregar">
            <i class="fa fa-plus" aria-hidden="true"></i> Nuevo
        </a>
    </div>

    <section class="productos-grupo">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4">

            {{#each productos}}
            <div class="col">
                <div class="card producto-card h-100">

                    {{{imagen}}}

                    <div class="card-body text-center">
                        <h5 class="card-title">{{titulo}}</h5>
                        <p class="card-text">{{descripcion}}</p>
                    </div>

                    <div>
                        <div class="d-flex justify-content-center gap-2 mb-4">
                            <a class="btn btn-secondary btn-sm" href="/admin/productos/modificar/{{id}}">
                                <i class="fa fa-pencil"></i>
                            </a>
                            <a class="btn btn-secondary btn-sm" href="/admin/productos/eliminar/{{id}}"
                                onclick="return confirm('¿Seguro que querés eliminar este producto?')">
                                <i class="fa fa-trash"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
            {{/each}}

        </div>
    </section>
</div>